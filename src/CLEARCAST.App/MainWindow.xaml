<Window x:Class="CLEARCAST.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CLEARCAST Audio" Width="860" Height="690" MinWidth="760" MinHeight="640" Background="#0B0F14" Foreground="#F1F5F9" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="20,10"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="ComboBox"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,8,0,18"/></Style>
 </Window.Resources>
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,24"><TextBlock Text="CLEARCAST" FontSize="28" FontWeight="Bold"/><TextBlock Text="Private noise reduction · processed on your computer" Foreground="#94A3B8" Margin="0,6,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="#151C25" CornerRadius="14" Padding="26">
   <StackPanel>
    <TextBlock Text="Your audio" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
    <TextBlock Text="Microphone"/><ComboBox x:Name="Microphone" DisplayMemberPath="Name" AutomationProperties.Name="Microphone"/>
    <TextBlock Text="Virtual microphone destination"/><ComboBox x:Name="Destination" DisplayMemberPath="Name" AutomationProperties.Name="Virtual microphone destination"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Button x:Name="StartButton" Content="Start" Click="Start_Click" IsEnabled="False" Background="#72E2BD"/><Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False"/><Button x:Name="RefreshButton" Content="Refresh devices" Click="Refresh_Click"/></StackPanel>
    <TextBlock x:Name="StateLabel" Text="Checking audio engine…" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock x:Name="StatusText" Text="Please wait." TextWrapping="Wrap" Foreground="#B6C5D5" Margin="0,8,0,16"/>
    <TextBlock Text="Microphone level" Foreground="#94A3B8"/><ProgressBar x:Name="InputLevel" Minimum="0" Maximum="1" Height="8" Margin="0,8,0,12"/>
    <TextBlock x:Name="Metrics" Foreground="#94A3B8" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <TextBlock Grid.Row="2" Text="In your meeting app, choose CABLE Output as the microphone.&#10;Local processing · your device choices are saved" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,18,0,0"/>
 </Grid>
</Window>
